"""
AfriHub Backend - Environment Configuration Template
Copy to .env and configure for your environment
"""

# ============== DATABASE ==============
DATABASE_URL=postgresql+asyncpg://afrhub_user:secure_password@localhost:5432/afrhub_db
DB_ECHO=false

# ============== REDIS CACHE ==============
REDIS_URL=redis://localhost:6379/0

# ============== AUTHENTICATION ==============
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============== PAYMENT GATEWAYS ==============
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
ORANGE_MONEY_API_KEY=xxx
MTN_MOBILE_MONEY_API_KEY=xxx

# ============== WHATSAPP BUSINESS API ==============
WHATSAPP_API_KEY=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxx

# ============== IMAGE STORAGE ==============
# Use Cloudflare R2, AWS S3, or local storage
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_R2_BUCKET=afrhub-media
CLOUDFLARE_R2_ACCESS_KEY=xxx
CLOUDFLARE_R2_SECRET_KEY=xxx
CLOUDFLARE_R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com

# ============== AI SERVICES (Optional) ==============
# For fraud detection and review moderation
OPENAI_API_KEY=sk-xxx  # Optional for AI features
HUGGINGFACE_API_KEY=xxx  # Alternative for open-source models

# ============== ANALYTICS ==============
SENTRY_DSN=https://xxx@sentry.io/xxx  # Error tracking
POSTHOG_API_KEY=phc_xxx  # Product analytics (optional)

# ============== APPLICATION ==============
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ============== RATE LIMITING ==============
RATE_LIMIT_PER_MINUTE=60  # Requests per minute per IP

# ============== CORS ==============
ALLOWED_ORIGINS=http://localhost:3000,https://afrhub.africa

# ============== FEATURE FLAGS ==============
ENABLE_WHATSAPP_INTEGRATION=true
ENABLE_ESCROW_PAYMENTS=true
ENABLE_AI_FRAUD_DETECTION=true
ENABLE_OFFLINE_MODE=true
